{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/grammar.schema.json",
  "name": "anki",
  "rules": {
    "source_file": {
      "type": "SEQ",
      "members": [
        {
          "type": "SYMBOL",
          "name": "header"
        },
        {
          "type": "SYMBOL",
          "name": "header"
        },
        {
          "type": "REPEAT",
          "content": {
            "type": "SYMBOL",
            "name": "field"
          }
        }
      ]
    },
    "header": {
      "type": "SEQ",
      "members": [
        {
          "type": "FIELD",
          "name": "key",
          "content": {
            "type": "ALIAS",
            "content": {
              "type": "TOKEN",
              "content": {
                "type": "CHOICE",
                "members": [
                  {
                    "type": "STRING",
                    "value": "Model"
                  },
                  {
                    "type": "STRING",
                    "value": "Deck"
                  }
                ]
              }
            },
            "named": true,
            "value": "key_name"
          }
        },
        {
          "type": "STRING",
          "value": ":"
        },
        {
          "type": "FIELD",
          "name": "value",
          "content": {
            "type": "ALIAS",
            "content": {
              "type": "PATTERN",
              "value": "[^\\n]*"
            },
            "named": true,
            "value": "value_content"
          }
        }
      ]
    },
    "field": {
      "type": "SEQ",
      "members": [
        {
          "type": "FIELD",
          "name": "name",
          "content": {
            "type": "ALIAS",
            "content": {
              "type": "TOKEN",
              "content": {
                "type": "PATTERN",
                "value": "[^:\\n]+:\\n"
              }
            },
            "named": true,
            "value": "field_name"
          }
        },
        {
          "type": "FIELD",
          "name": "body",
          "content": {
            "type": "REPEAT",
            "content": {
              "type": "CHOICE",
              "members": [
                {
                  "type": "SYMBOL",
                  "name": "typst_block"
                },
                {
                  "type": "SYMBOL",
                  "name": "latex_block"
                },
                {
                  "type": "SYMBOL",
                  "name": "text"
                }
              ]
            }
          }
        }
      ]
    },
    "typst_block": {
      "type": "SEQ",
      "members": [
        {
          "type": "FIELD",
          "name": "typst_open_tag",
          "content": {
            "type": "ALIAS",
            "content": {
              "type": "STRING",
              "value": "[typst]"
            },
            "named": true,
            "value": "typst_open_tag"
          }
        },
        {
          "type": "FIELD",
          "name": "content",
          "content": {
            "type": "ALIAS",
            "content": {
              "type": "SYMBOL",
              "name": "_block_content"
            },
            "named": true,
            "value": "typst"
          }
        },
        {
          "type": "FIELD",
          "name": "typst_close_tag",
          "content": {
            "type": "ALIAS",
            "content": {
              "type": "STRING",
              "value": "[/typst]"
            },
            "named": true,
            "value": "typst_close_tag"
          }
        }
      ]
    },
    "latex_block": {
      "type": "SEQ",
      "members": [
        {
          "type": "FIELD",
          "name": "latex_open_tag",
          "content": {
            "type": "ALIAS",
            "content": {
              "type": "STRING",
              "value": "[latex]"
            },
            "named": true,
            "value": "latex_open_tag"
          }
        },
        {
          "type": "FIELD",
          "name": "content",
          "content": {
            "type": "ALIAS",
            "content": {
              "type": "SYMBOL",
              "name": "_block_content"
            },
            "named": true,
            "value": "latex"
          }
        },
        {
          "type": "FIELD",
          "name": "latex_close_tag",
          "content": {
            "type": "ALIAS",
            "content": {
              "type": "STRING",
              "value": "[/latex]"
            },
            "named": true,
            "value": "latex_close_tag"
          }
        }
      ]
    },
    "_block_content": {
      "type": "PREC",
      "value": -1,
      "content": {
        "type": "REPEAT1",
        "content": {
          "type": "CHOICE",
          "members": [
            {
              "type": "PATTERN",
              "value": "."
            },
            {
              "type": "PATTERN",
              "value": "\\n"
            }
          ]
        }
      }
    },
    "text": {
      "type": "PATTERN",
      "value": "[^\\[\\n]+"
    }
  },
  "extras": [
    {
      "type": "PATTERN",
      "value": "\\s"
    }
  ],
  "conflicts": [],
  "precedences": [],
  "externals": [],
  "inline": [],
  "supertypes": [],
  "reserved": {}
}